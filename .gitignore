# OS files
.DS_Store
Thumbs.db
desktop.ini

# IntelliJ: only the shared code style and copyright profile are tracked
.idea/*
!.idea/codeStyles/
!.idea/copyright/
*.iml

# Other editors
.vscode/
*.code-workspace
*.swp
*~

# Go build and test outputs (root dist/ only, so web/dist/.gitkeep survives)
/dist/
/bin/
/build/
/coverage.out
/coverage.html
*.test
*.out
*.prof
*.pprof
*.coverprofile
profile.*

# Go workspaces and vendoring
go.work
go.work.sum
vendor/

# Node: any node_modules/ anywhere in the repository
node_modules/

# Tool caches
.cache/
.fallow/

# Claude Code: the shared settings and the skills symlink are tracked; local settings
# (settings.local.json) and session state never are.
.claude/*
!.claude/settings.json
!.claude/skills
