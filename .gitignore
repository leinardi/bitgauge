# OS files
.DS_Store
Thumbs.db
desktop.ini

# IntelliJ: only the shared code style and copyright profile are tracked
.idea/*
!.idea/codeStyles/
!.idea/copyright/
*.iml

# Other editors
.vscode/
*.code-workspace
*.swp
*~

# Build and test outputs (root dist/ only, so web/dist/.gitkeep survives)
/dist/
/bin/
/build/
/coverage.out
/coverage.html
*.test
*.out
*.prof
*.pprof
*.coverprofile
profile.*

# Cargo build outputs
/target/

# Node: any node_modules/ anywhere in the repository
node_modules/

# Tool caches
.cache/
.fallow/

# Demo parity harness: the CDN cache, the run records and the HTML report
web/parity/.cache/
web/parity/.run/
web/playwright-report/

# playwright-cli session output (snapshots, console logs, downloads), wherever it is run from
.playwright-cli/

# Claude Code: the shared settings and the skills symlink are tracked; local settings
# (settings.local.json) and session state never are.
.claude/*
!.claude/settings.json
!.claude/skills
