{
  "enabledPlugins": {
    "fallow@fallow-skills": true
  },
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make check-stage)",
      "Bash(make verify)",
      "Bash(make verify-web)",
      "Bash(make web-lint)",
      "Bash(make web-test)",
      "Bash(make web-build)",
      "Bash(make api-types)",
      "Bash(make verify-rust)",
      "Bash(make rust-build)",
      "Bash(make rust-test)",
      "Bash(make rust-clippy)",
      "Bash(make rust-fmt)",
      "Bash(make rust-fmt-check)",
      "Bash(make rust-doc)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo tree *)",
      "Bash(cargo doc *)",
      "Bash(rustfmt *)",
      "Bash(pre-commit run *)",
      "Bash(npm --prefix web run lint)",
      "Bash(npm --prefix web run typecheck)",
      "Bash(npm --prefix web run test)",
      "Bash(scripts/check-*.sh)",
      "Bash(scripts/check-*.sh *)",
      "mcp__serena__initial_instructions",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__get_diagnostics_for_file",
      "mcp__serena__list_memories",
      "mcp__serena__read_memory"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/rustfmt-on-edit.sh"
          }
        ]
      }
    ]
  }
}
