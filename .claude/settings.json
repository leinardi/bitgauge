{
  "enabledPlugins": {
    "fallow@fallow-skills": true
  },
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make check-stage)",
      "Bash(make go-build)",
      "Bash(make go-test)",
      "Bash(make go-vet)",
      "Bash(make go-lint)",
      "Bash(make verify)",
      "Bash(make verify-go)",
      "Bash(make verify-web)",
      "Bash(make web-lint)",
      "Bash(make web-test)",
      "Bash(make web-build)",
      "Bash(make api-types)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(pre-commit run *)",
      "Bash(golangci-lint run *)",
      "Bash(npm --prefix web run lint)",
      "Bash(npm --prefix web run typecheck)",
      "Bash(npm --prefix web run test)",
      "Bash(scripts/check-*.sh)",
      "Bash(scripts/check-*.sh *)",
      "mcp__serena__initial_instructions",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__get_diagnostics_for_file",
      "mcp__serena__list_memories",
      "mcp__serena__read_memory"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/gofmt-on-edit.sh"
          }
        ]
      }
    ]
  }
}
