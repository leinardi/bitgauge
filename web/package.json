{
  "name": "bitgauge-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.engine.json && vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src e2e '*.config.ts' --max-warnings 0 --cache --cache-strategy content --cache-location .cache/eslint",
    "lint:fix": "eslint src e2e '*.config.ts' --fix --max-warnings 0 --cache --cache-strategy content --cache-location .cache/eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "harness": "playwright test -c playwright.harness.config.ts",
    "api-types": "openapi-typescript ../api/openapi.yaml -o src/api/types.gen.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fallow": "3.32.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "allowScripts": {
    "fsevents": false
  },
  "dependencies": {
    "@lucide/vue": "^1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uplot": "^1.6.32",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  }
}
