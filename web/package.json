{
  "name": "bitgauge-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_DEMO=1 vite",
    "build": "vite build",
    "build:demo": "VITE_DEMO=1 vite build --outDir dist-demo",
    "typecheck": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.engine.json && vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.e2e.json && vue-tsc --noEmit -p tsconfig.parity.json",
    "lint": "eslint src e2e parity '*.config.ts' --max-warnings 0 --cache --cache-strategy content --cache-location .cache/eslint",
    "lint:fix": "eslint src e2e parity '*.config.ts' --fix --max-warnings 0 --cache --cache-strategy content --cache-location .cache/eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "BITGAUGE_PARITY_UNIT=1 vitest run",
    "e2e": "playwright test",
    "harness": "playwright test harness/run.spec.ts -c playwright.harness.config.ts",
    "parity": "npm run test:parity && playwright test -c playwright.parity.config.ts",
    "parity:serve:demo": "npm run build:demo && vite preview --outDir dist-demo --host 127.0.0.1 --port \"${PARITY_DEMO_PORT:-5182}\" --strictPort",
    "parity:serve:prototype": "python3 -m http.server --directory ../docs/design_system --bind 127.0.0.1 \"${PARITY_PROTO_PORT:-5183}\" 2>/dev/null",
    "api-types": "openapi-typescript ../api/openapi.yaml -o src/api/types.gen.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "fake-indexeddb": "^6.2.6",
    "fallow": "3.37.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "fsevents": false
  },
  "dependencies": {
    "@lucide/vue": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uplot": "^1.6.32",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  }
}
