{
  "name": "bitgauge-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src '*.config.ts' --max-warnings 0 --cache --cache-strategy content --cache-location .cache/eslint",
    "lint:fix": "eslint src '*.config.ts' --fix --max-warnings 0 --cache --cache-strategy content --cache-location .cache/eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "harness": "playwright test -c playwright.harness.config.ts",
    "api-types": "openapi-typescript ../api/openapi.yaml -o src/api/types.gen.ts"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "allowScripts": {
    "fsevents": false
  }
}
