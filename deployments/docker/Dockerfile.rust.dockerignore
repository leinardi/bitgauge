# The build context of Dockerfile.rust, which BuildKit reads in place of the root .dockerignore:
# the root file's exclusions, and the two a Cargo build needs changed. target/ is the host's own
# build, never an input. tests/ stays out except its Rust files, since the manifest's [[test]]
# targets must exist for cargo to read it; their data is not needed.

# VCS
.git
.gitignore
.gitattributes

# CI, docs, tests and agent tooling: none of it is an input of the image
.github
.claude
.agents
.serena
docs
test
tests/**
!tests/*.rs
!tests/support/**
*.md
# Except the design export's tokens, element defaults, fonts, icons and manifest, which the web
# stage builds in (frontend.md section 8).
!docs/design_system/colors_and_type.css
!docs/design_system/base.css
!docs/design_system/assets/**

# Local artifacts
dist
coverage.out
coverage.html
target

# Editor/IDE
.idea
.vscode
*.swp
*.swo

# Node caches. Any depth: web/node_modules is installed inside the image, never shipped in.
**/node_modules
web/.cache
web/test-results
web/playwright-report
.fallow

# A developer's local frontend build must never be what an image embeds; the web stage builds its
# own. The tracked .gitkeep stays, so the embed directory exists for build.rs.
web/dist/*
!web/dist/.gitkeep
